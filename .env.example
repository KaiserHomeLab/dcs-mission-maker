# Copy to .env and fill in what you use. Everything is optional.

# How friends reach this app (used in sign-up links posted to Discord),
# e.g. http://192.168.1.20:8080 or https://missions.example.com
PUBLIC_URL=

# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Publish to a DCS server folder that this machine can reach (same PC, or an
# SMB/NFS share mounted on this host). Set the host path; leave both empty to disable.
SERVER_MISSIONS_HOST_DIR=
SERVER_MISSIONS_DIR=/server-missions

# Or upload over SFTP (e.g. a rented Windows box running OpenSSH).
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
# SFTP_KEY_FILE=/run/secrets/id_rsa
# Path on the server, e.g. C:/Users/dcs/Saved Games/DCS.openbeta_server/Missions
SFTP_PATH=
# Optional: a known_hosts file (mounted into the container) to verify the server's key
# SFTP_KNOWN_HOSTS=/run/secrets/known_hosts

# SRS (Simple Radio Standalone) voice server your group uses, e.g. srs.example.com:5002.
# Shown on the Comms tab, comm card, kneeboards and Discord posts. Don't put the password here;
# SRS_NOTE can say where to find it, e.g. "password in #dcs-info".
SRS_ADDRESS=
SRS_NOTE=

# Optional password for the mission builder and everything that generates, publishes
# or deletes (your browser asks for it; any user name). Sign-up pages, the Briefing Room,
# downloads and the DCS server hook stay open so pilots and the server can use them.
# Set this if the app is reachable from the internet. Use HTTPS (a reverse proxy) too.
APP_PASSWORD=

# Worker processes (each builds one mission at a time). Default 3.
# WEB_CONCURRENCY=3

# Generated missions are temporary: deleted this many hours later unless someone presses
# Keep (missions posted to Discord, published to a server or made from a sign-up are kept
# automatically). Default 24.
# MISSION_TTL_HOURS=24
