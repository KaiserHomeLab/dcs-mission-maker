# Local settings and secrets
.env

# Runtime data (generated missions, setups, events, sign-ups, reports)
missions/*
!missions/.gitkeep
server-missions/*
!server-missions/.gitkeep
# Your own mission scripts
scripts/*
!scripts/README.md

# Python / tooling
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.venv/
node_modules/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Downloaded by tools/fetch_vendor.py (windows/setup.bat)
/vendor/
# Original images for tools/art_drawings.py (the cleaned copies in app/data/drawings/ are kept)
/art/drawings/
build/
dist/
# Written by the release build (.github/workflows/release.yml)
app/build_info.py
